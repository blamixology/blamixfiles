<?xml version="1.0" encoding="utf-8"?>
<!--
  BlamixFiles Windows installer (WiX Toolset v5).

  Dual-purpose package: the installer ASKS whether to install
    • for all users  -> C:\Program Files\BlamixFiles           (needs admin)
    • just for me    -> %LOCALAPPDATA%\Programs\BlamixFiles    (no admin)
  Silent installs:
    msiexec /i BlamixFiles.msi /qn ALLUSERS=1                        (all users)
    msiexec /i BlamixFiles.msi /qn ALLUSERS=2 MSIINSTALLPERUSER=1    (current user)

  Build: see packaging/windows/build_msi.ps1
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- UpgradeCode: never change it, or new versions won't replace old installs. -->
  <Package Name="BlamixFiles"
           Manufacturer="BlamixFiles contributors"
           Version="$(var.Version)"
           UpgradeCode="2b8802fa-d449-4eda-9b47-5c52b6d7146a"
           Scope="perUserOrMachine"
           Compressed="yes"
           Language="1033">

    <SummaryInformation Description="BlamixFiles file transfer client" />
    <!-- Upgrades remove the old version first, inside the same transaction
         (if the new install fails, the old version is rolled back in place). -->
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of BlamixFiles is already installed." />

    <!-- An "all users" and a "just for me" copy can't upgrade each other (Windows keeps
         the two contexts apart), so installing over the other kind would leave two copies
         or fail half-way (error 2349/1603). Detect the other copy and stop with a clear
         message instead. HKMU values below land in HKLM (all users) or HKCU (just me). -->
    <Property Id="BF_MACHINE_COPY" Secure="yes">
      <RegistrySearch Id="FindMachineCopy" Root="HKLM" Key="Software\BlamixFiles"
                      Name="StartMenuShortcut" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="BF_USER_COPY" Secure="yes">
      <RegistrySearch Id="FindUserCopy" Root="HKCU" Key="Software\BlamixFiles"
                      Name="StartMenuShortcut" Type="raw" />
    </Property>
    <CustomAction Id="BlockOverMachineCopy"
                  Error="BlamixFiles is already installed for all users (in Program Files). Choose &quot;Install for all users&quot; to upgrade it, or uninstall it first from Settings &gt; Apps." />
    <CustomAction Id="BlockOverUserCopy"
                  Error="BlamixFiles is already installed just for your account (in AppData). Choose &quot;Install just for you&quot; to upgrade it, or uninstall it first from Settings &gt; Apps." />
    <InstallExecuteSequence>
      <!-- runs before any file is touched; the install scope is final by now -->
      <Custom Action="BlockOverMachineCopy" After="AppSearch"
              Condition="BF_MACHINE_COPY AND NOT Installed AND ((ALLUSERS=2 AND MSIINSTALLPERUSER=1) OR NOT ALLUSERS)" />
      <Custom Action="BlockOverUserCopy" After="BlockOverMachineCopy"
              Condition="BF_USER_COPY AND NOT Installed AND (ALLUSERS=1 OR (ALLUSERS=2 AND NOT MSIINSTALLPERUSER=1))" />
    </InstallExecuteSequence>

    <!-- Files of a running BlamixFiles can't be replaced: ask it to close, and end it
         if it doesn't within a few seconds. -->
    <util:CloseApplication Id="CloseBlamixFiles" Target="BlamixFiles.exe"
                           CloseMessage="yes" TerminateProcess="1" Timeout="5" RebootPrompt="no" />
    <!-- one embedded cabinet -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" MaximumUncompressedMediaSize="1800" />

    <!-- Apps & features entry -->
    <Icon Id="AppIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/blamixology/blamixfiles" />
    <Property Id="ARPHELPLINK" Value="https://github.com/blamixology/blamixfiles/issues" />

    <!-- WixUI_Advanced = welcome/license -> "Install for all users / just for me" -> folder -> features -->
    <Property Id="ApplicationFolderName" Value="BlamixFiles" />
    <Property Id="WixAppFolder" Value="WixPerMachineFolder" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <ui:WixUI Id="WixUI_Advanced" />
    <!-- WixUI_Advanced defaults to the 32-bit Program Files and %LOCALAPPDATA%\Apps.
         Point it at the 64-bit Program Files and the standard per-user %LOCALAPPDATA%\Programs,
         for interactive AND silent installs (Sequence="both"). -->
    <SetProperty Id="WixPerMachineFolder" Value="[ProgramFiles64Folder][ApplicationFolderName]"
                 After="WixSetDefaultPerMachineFolder" Sequence="both" />
    <SetProperty Id="WixPerUserFolder" Value="[LocalAppDataFolder]Programs\[ApplicationFolderName]"
                 After="WixSetDefaultPerUserFolder" Sequence="both" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="APPLICATIONFOLDER" Name="BlamixFiles" />
    </StandardDirectory>

    <Feature Id="Main" Title="BlamixFiles" Description="The BlamixFiles application."
             Level="1" AllowAbsent="no" Display="expand">
      <!-- the whole PyInstaller output folder (includes installed.marker) -->
      <Files Directory="APPLICATIONFOLDER" Include="$(var.SourceDir)\**" />

      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="c5e8c20d-0179-44a3-804f-62df0f99683a">
        <Shortcut Id="StartMenuSc" Name="BlamixFiles" Description="File transfer: SFTP, FTP/FTPS, S3, WebDAV, sync and a built-in editor"
                  Target="[APPLICATIONFOLDER]BlamixFiles.exe" WorkingDirectory="APPLICATIONFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKMU" Key="Software\BlamixFiles" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>

    <Feature Id="DesktopShortcut" Title="Desktop shortcut" Description="Add a BlamixFiles icon to the desktop." Level="1">
      <Component Id="DesktopShortcutComp" Directory="DesktopFolder" Guid="589bc558-fc43-465b-b666-ab1808fc9a33">
        <Shortcut Id="DesktopSc" Name="BlamixFiles" Target="[APPLICATIONFOLDER]BlamixFiles.exe"
                  WorkingDirectory="APPLICATIONFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKMU" Key="Software\BlamixFiles" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
